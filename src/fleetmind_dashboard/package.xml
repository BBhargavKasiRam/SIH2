<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleetmind_dashboard</name>
  <version>0.1.0</version>
  <description>Lightweight web-based fleet monitoring dashboard for FleetMind Edge-AI AMR coordination.</description>
  <maintainer email="fleetmind@example.com">FleetMind Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>fleetmind_msgs</depend>
  <depend>rmf_fleet_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
